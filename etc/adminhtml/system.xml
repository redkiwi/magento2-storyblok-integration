<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="medialounge" translate="label" sortOrder="999">
            <label>Media Lounge</label>
        </tab>
        <section id="storyblok" translate="label" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Storyblok</label>
            <tab>medialounge</tab>
            <resource>MediaLounge_Storyblok::storyblok_config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_key" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key</label>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="webhook_signature_validation" translate="label comment" type="select" sortOrder="29" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Webhook Signature Validation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable webhook signature validation for security. Disable for testing or Starter Subscription.</comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="webhook_secret" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Webhook Secret</label>
                    <validate>required-entry validate-length minimum-length-20</validate>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="slug_prefix" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Slug Prefix</label>
                    <comment>Add a prefix to the slug to fetch content from a folder.</comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="resolve_links" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Resolve Links</label>
                    <source_model>MediaLounge\Storyblok\Model\Config\Source\ResolveLinks</source_model>
                    <comment><![CDATA[
                        <strong>URL:</strong> Returns translated URLs for internal links (recommended for multilingual sites, max 500 links)<br/>
                        <strong>Link:</strong> Returns additional metadata like parent_id, is_folder (max 500 links)<br/>
                        <strong>Story:</strong> Returns full story content (heavy performance impact, max 50 links)<br/>
                        <strong>Disabled:</strong> No link resolution, links remain as UUIDs
                    ]]></comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="language" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Language Code</label>
                    <comment>Storyblok language code (e.g. nl-NL, de-DE). Leave empty to use transformed locale (underscore replaced with dash).</comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="fallback_language" translate="label comment" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Fallback Language</label>
                    <comment>Fallback language code (e.g. nl, de). Leave empty to use language part of locale.</comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="excluded_content_types" translate="label comment" type="textarea" sortOrder="80" showInDefault="1">
                    <label>Excluded Content Types</label>
                    <comment>Content types that should not be routed (one per line). These will not be accessible via direct URLs. Example: download</comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="asset_proxy_enabled" translate="label comment" type="select" sortOrder="85" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Asset Proxy</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, Storyblok asset URLs are rewritten to route through Magento for Varnish caching.</comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="asset_hosts" translate="label comment" type="text" sortOrder="86" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Asset Hosts</label>
                    <validate>required-entry</validate>
                    <comment><![CDATA[Comma-separated Storyblok asset hostnames. The first host is used for fetching, all are matched for URL rewriting. Find your region's hosts at <a href="https://www.storyblok.com/docs/concepts/assets" target="_blank">Storyblok Asset Documentation</a>.<br/>Examples: EU: a.storyblok.com, US: a-us.storyblok.com, AU: a-ap.storyblok.com, CA: a-ca.storyblok.com, CN: a.storyblokchina.cn. Add a2-* variants for CORS support.]]></comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                        <field id="storyblok/general/asset_proxy_enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="home_page" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Home Page</label>
                <field id="home_slug" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Home Slug</label>
                    <comment>The slug used for the content on the home page.</comment>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="seo" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>SEO</label>
                <field id="show_breadcrumbs" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Breadcrumbs</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
                <field id="add_canonical" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Add Canonical Link</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="storyblok/general/enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
        <section id="sitemap">
            <group id="storyblok" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Storyblok Options</label>
                <field id="changefreq" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Frequency</label>
                    <source_model>Magento\Sitemap\Model\Config\Source\Frequency</source_model>
                </field>
                <field id="priority" translate="label comment" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Priority</label>
                    <backend_model>Magento\Sitemap\Model\Config\Backend\Priority</backend_model>
                    <comment>Valid values range from 0.0 to 1.0.</comment>
                </field>
            </group>
        </section>
    </system>
</config>